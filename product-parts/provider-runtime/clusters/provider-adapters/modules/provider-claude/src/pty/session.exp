# Starts one interactive Claude Code session with Remote Control in a project folder, or resumes
# a local session under the same Remote Control id when a fifth argument (its local id) is given.
# Usage: expect session.exp <folder> <claude> <title> <debug file> [<local id>]
# With $WFK_FIRST_MESSAGE set (one line), the message is typed into the new session and sent
# once the link is on the screen.
# Prints (each on its own line):
#   CLAUDE_PID <pid>          pid of the spawned claude (D9: the supervisor tracks it)
#   SESSION_URL session_<id>  once claude.ai has the session (primary source of the id)
#   NO_SESSION_URL            no link on the screen in time; the session keeps running and the
#                             backend falls back to the debug file ("Created session cse_<id>")
#   SESSION_NOT_TRUSTED       the folder is not trusted (exit 5)
#   SESSION_EXITED            claude exited before a link appeared (exit 4)
#   DIALOG <kind>             claude showed a dialog; it was stopped, no key pressed (exit 6)
#   PROMO_DECLINED <n>        a feature offer got "Not now" (option <n>); the wait goes on (M15)
#   RENAMED                   the name from <debug file>.rename was typed as /rename <name>
#   MESSAGE_SENT              <debug file>.text (the UTF-8 text) was pasted as a bracketed paste
#                             (ESC[200~ … ESC[201~), then Enter after 700 ms; a wake waiting in
#                             <debug file>.message is then dropped (the message starts the turn)
#   WOKEN                     <debug file>.message (any content) asked to wake the idle session: a
#                             short prompt was typed, the prompt hook then hands the panel's queue to the agent
# claude runs with WFK_PANEL_SESSION=1: its hooks inherit it and tell the service the panel runs it.
# After the link the screen is no longer copied to the log; the session lives until claude exits.
# Once a second the script looks for <debug file>.rename (written by the service only while the
# session is not in a turn, so no dialog can take the keys): it reads one line, deletes the file
# and types /rename <name> (an immediate command of Claude that also renames Remote Control).
set timeout 90
lassign $argv dir claude title debug resume
# The first message is not passed on to claude's environment.
set first ""
if {[info exists env(WFK_FIRST_MESSAGE)]} {
  set first $env(WFK_FIRST_MESSAGE)
  unset env(WFK_FIRST_MESSAGE)
}
source [file join [file dirname [info script]] dialogs.tcl]
source [file join [file dirname [info script]] interrupt.tcl]
cd $dir
# Marks the panel's process for the hooks (spec M19 section 2.2).
set env(WFK_PANEL_SESSION) 1
if {$resume ne ""} {
  spawn $claude --resume $resume --remote-control $title --debug-file $debug
} else {
  spawn $claude --remote-control $title --debug-file $debug
}
puts "\nCLAUDE_PID [exp_pid]"
# Without a controlling terminal the pty has no size and claude prints nothing; give it one.
stty rows 40 columns 160 < $spawn_out(slave,name)
expect {
  -re {claude\.ai/code/(session_[A-Za-z0-9]+)} {
    puts "\nSESSION_URL $expect_out(1,string)"
    if {$first ne ""} {
      after 1500
      send -- $first
      after 500
      send "\r"
      puts "\nFIRST_MESSAGE_SENT"
    }
  }
  -re {Workspace not trusted} { puts "\nSESSION_NOT_TRUSTED"; exit 5 }
  -re $dialog_pattern { if {[handle_dialog $expect_out(buffer)] eq "declined"} { exp_continue } }
  timeout { puts "\nNO_SESSION_URL" }
  eof { puts "\nSESSION_EXITED"; exit 4 }
}
if {[info exists expect_out(buffer)]} { interrupt_data $expect_out(buffer) }
log_user 0
set control "$debug.rename"
set timeout 1
expect {
  -re {(?s).+} { interrupt_data $expect_out(buffer); exp_continue -continue_timer }
  eof {}
  timeout {
    interrupt_tick
    if {[file exists $control]} {
      set name ""
      catch {
        set handle [open $control r]
        fconfigure $handle -encoding utf-8
        set name [string trim [read $handle]]
        close $handle
      }
      file delete -force $control
      regsub -all {\s+} $name { } name
      if {$name ne ""} {
        send -- "/rename $name"
        after 300
        send "\r"
        puts "\nRENAMED"
      }
    }
    set textfile "$debug.text"
    set pasted 0
    if {[file exists $textfile]} {
      set content ""
      catch {
        set handle [open $textfile r]
        fconfigure $handle -encoding utf-8
        set content [read $handle]
        close $handle
      }
      file delete -force $textfile
      if {$content ne ""} {
        # A bracketed paste keeps all lines one user message (spec M19 section 2.1).
        send -- "\033\[200~$content\033\[201~"
        after 700
        send "\r"
        puts "\nMESSAGE_SENT"
        set pasted 1
      }
    }
    # Any content of <debug>.message is a wake; a message pasted just now starts the turn itself.
    set wake "$debug.message"
    if {[file exists $wake]} {
      file delete -force $wake
      if {!$pasted} {
        send -- "Workflow Kit: новое сообщение из панели."
        after 300
        send "\r"
        puts "\nWOKEN"
      }
    }
    exp_continue
  }
}
puts "\nSESSION_ENDED"
