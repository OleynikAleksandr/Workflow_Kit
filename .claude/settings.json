{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/wfk\" ] && \"$HOME/.local/bin/wfk\" hook session-start --client claude; exit 0"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/workflow\" hook session-start --client claude --part 1/6",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/workflow\" hook session-start --client claude --part 2/6",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/workflow\" hook session-start --client claude --part 3/6",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/workflow\" hook session-start --client claude --part 4/6",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/workflow\" hook session-start --client claude --part 5/6",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/workflow\" hook session-start --client claude --part 6/6",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/wfk\" ] && \"$HOME/.local/bin/wfk\" hook stop --client claude; exit 0",
            "timeout": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/wfk\" ] && \"$HOME/.local/bin/wfk\" hook prompt --client claude; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
