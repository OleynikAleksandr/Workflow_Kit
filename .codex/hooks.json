{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "scripts/workflow hook session-start --client codex",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/wfk\" ] && \"$HOME/.local/bin/wfk\" hook session-start --client codex; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/wfk\" ] && \"$HOME/.local/bin/wfk\" hook stop --client codex; exit 0",
            "timeoutSec": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/wfk\" ] && \"$HOME/.local/bin/wfk\" hook prompt --client codex; exit 0",
            "timeoutSec": 30
          }
        ]
      }
    ]
  }
}
