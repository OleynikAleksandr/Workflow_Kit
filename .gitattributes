# Line endings: LF everywhere; the workflow-kit block below keeps CRLF for its Windows launchers.
* text=auto eol=lf
*.node binary
*.dll binary
*.exe binary
*.png binary
*.ico binary
*.icns binary

# workflow-kit:begin
scripts/workflow text eol=lf
scripts/workflow.cmd text eol=crlf
scripts/workflow.ps1 text eol=crlf
.harness/** text eol=lf
# workflow-kit:end
